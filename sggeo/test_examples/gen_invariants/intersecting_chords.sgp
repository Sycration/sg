sgp 2

given
  k1 = circle(O)
    r1: r(k1) = 3
  point A
    d1: dist(O, A) = 1

construct
  point B on k1
  point C on k1
  segment BC
    A on BC
  point D on k1
    d2: dist(A, D) = 2
  point E on k1
  segment DE
    A on DE

find
  d3: dist(A, E)
  d4: dist(A, B)
  d5: dist(A, C)

where
  k1 r 3
  A (0.008197405903507229, 0.9999664007037702)
  B (2.4752147171823746, 1.695084689283629)
  C (-2.9960719484923, 0.1534694740251429)
  D (0.02459218406830074, 2.9998992023870987)
  E (-0.024592150426079772, -2.999899202662886)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  d5 label (0.3, 0.3)
