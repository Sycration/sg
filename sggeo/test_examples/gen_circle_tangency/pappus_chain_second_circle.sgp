sgp 2

given
  point D
  k4 = circle(D)
  point E
  k5 = circle(E)
    k5 tan k4

construct
  point A on xaxis
  k1 = circle(A)
    k4 tan k1 inside
    k5 tan k1 inside
  point B on xaxis
  point C on xaxis
  k2 = circle(B)
    k1 tan k2 inside
    k4 tan k2
    k5 tan k2
    r1: r(k2) = 3
  k3 = circle(C)
    k1 tan k3 inside
    k2 tan k3
    k4 tan k3
    r2: r(k3) = 2

find
  r3: r(k5)

where
  D (1.3158380305602717, 3.1578947368421053)
  k4 r 1.5789473684210524
  E (-1.128983701188455, 3.870967741935484)
  k5 r 0.9677419354838711
  A (0.000048556876061126414, 7.703719777548943e-34)
  k1 r 5
  B (-1.999951443123939, 1.8488927466117464e-32)
  C (3.0000485568760613, 0)
  k2 r 3
  k3 r 2
  r1 label (0.3, 0.3)
  r2 label (0.3, 0.3)
  r3 label (0.3, 0.3)
