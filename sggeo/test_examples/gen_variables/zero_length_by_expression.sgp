sgp 2

given
  segment OA
    horiz O A
    d1: |OA| = 3
  segment OC
    d3: |OC| = 4
  segment BC
    d2: dist(A, B) = d1 - 3
    d4: |BC| = 5

find
  y_C: y(C)

where
  A (3, 0)
  C (5.84919038342794e-8, 4)
  B (3.000000014535858, -3.296703444962731e-8)
  d1 label (0.3, 0.3)
  d3 label (0.3, 0.3)
  d2 label (0.3, 0.3)
  d4 label (0.3, 0.3)
  y_C label (0.3, 0.3)
