sgp 2

given
  k1 = circle(O)
    r1: r(k1) = 2

construct
  point A on xaxis
    A on k1
  polygon ABCD
    B on k1
    C on k1
    D on k1
    |AB| == |BC|
    |AB| == |CD|
    |AB| == |DA|

find
  d1: |AB|

where
  k1 r 2
  A (2, 3.4438311059246704e-41)
  B (-5.797133960496783e-17, 2)
  C (-2, 7.138318520096646e-17)
  D (3.487005746006796e-17, -2)
  r1 label (0.3, 0.3)
  d1 label (0.3, 0.3)
